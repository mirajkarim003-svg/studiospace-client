# ---- StudioSpace client (copy this file to .env.local and fill in) ----

# Address of the Express server. Local: http://localhost:5000  | Live: your Render URL
API_URL=http://localhost:5000

# Same MongoDB database as the server (Better Auth stores users/sessions here)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=studiospace

# Better Auth. BETTER_AUTH_URL is the address of THIS website.
# Local: http://localhost:3000  | Live: your Vercel URL (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Must be EXACTLY the same value as JWT_SECRET in the server .env
JWT_SECRET=replace-with-a-long-random-string

# Google login (optional but required by the assignment). See README for the 2-minute setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# imgbb image upload (optional). Get a free key at https://api.imgbb.com/
# Without it the "Upload image" button is hidden and you can paste image URLs instead.
NEXT_PUBLIC_IMGBB_KEY=
